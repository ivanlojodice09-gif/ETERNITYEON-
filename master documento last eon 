4. IL CUORE VISIVO: SHADER GLSL ("BIOLUMINESCENCE")
Inserire in un GLSL TOP per generare filamenti organici che reagiscono a uOmega.

uniform float uOmega; // Velocità pulsazioneuniform float uTime; // absTime.secondsuniform float uCaos; // Mix stato (0.0 ordine, 1.0 caos)
out vec4 fragColor;
void main() {
vec2 uv = vUV.st;
float pulse = sin(uTime * uOmega) * 0.5 + 0.5;

// Distorsione filamenti
float noise = fract(sin(dot(uv, vec2(12.9, 78.2))) * 43758.5);
float line = smoothstep(0.15, 0.0, abs(uv.y - 0.5 + sin(uv.x * 10.0 + uTime) * (0.1 + uCaos * 0.3)));

// Colore: Blu Etereo -> Oro Caotico
vec3 col = mix(vec3(0.05, 0.1, 0.4), vec3(1.0, 0.7, 0.2), uCaos);
fragColor = vec4(col * line * (pulse + 0.2), 1.0);
}

