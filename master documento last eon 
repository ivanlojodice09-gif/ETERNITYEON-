2. AUTOMAZIONE DEL PROGETTO (ext_loader.py)
Script da inserire in un Text DAT. Gestisce l'avvio, la risoluzione e la gestione errori.

import jsonimport os
def onStart():
path = project.folder + "/config_lasteon.json"
if not os.path.exists(path):
debug("ERRORE: JSON non trovato. Uso parametri di backup."); return

try:
with open(path, 'r') as f:
data = json.load(f)

# Sync Parametri Bio
c = op('constant_bio')
c.par.value0 = data['frequencies']['gain_factor'] # Omega Gain
c.par.value1 = data['thresholds']['touch_caos'] # Caos Trigger

# Sync Display
op('render_final').par.w, op('render_final').par.h = data['display']['resolution']
op('window1').par.winopen.pulse() # Apre Performance Mode
print("Last Eon: Sistema Sincronizzato.")
except Exception as e:
debug(f"Errore caricamento: {e}")

