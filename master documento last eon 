5. CONTROLLO FISICO E SICUREZZA (Arduino Sketch)
Gestione relay con Safety Timeout per evitare allagamenti in caso di crash del PC.

const int RELAY_PIN = 8;unsigned long lastWaterTime = 0;const unsigned long TIMEOUT = 5000; // Spegnimento forzato dopo 5 secondi
void setup() {
Serial.begin(115200);
pinMode(RELAY_PIN, OUTPUT);
digitalWrite(RELAY_PIN, LOW);
}
void loop() {
if (Serial.available() > 0) {
char cmd = Serial.read();
if (cmd == 'W') { digitalWrite(RELAY_PIN, HIGH); lastWaterTime = millis(); }
if (cmd == 'S') { digitalWrite(RELAY_PIN, LOW); }
}
// Protezione hardware
if (digitalRead(RELAY_PIN) == HIGH && (millis() - lastWaterTime > TIMEOUT)) {
digitalWrite(RELAY_PIN, LOW);
}
}

